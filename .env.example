# Complete template. Dev uses .env; prod uses .env.prod (the deploy script copies it to .env on the VM).
# Lines marked [prod] are the ones to change for production.

# Communal keys. [prod] use keys made only for this site, with daily limits set on each provider too.
# When both are set, OpenRouter is tried first; if its budget is exhausted, TypeSafe takes over silently.
OPENROUTER_API_KEY=your-key-here
# OPENROUTER_MODEL=typesafe/jev-1.13
# OPENROUTER_URL=https://openrouter.ai/api/alpha/decisions

# TypeSafe direct (optional fallback or primary)
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-1.13
# TYPESAFE_URL=https://api.typesafe.ai/v1/systemone

# [prod] Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token. Only compose-homelab.yml reads it.
TUNNEL_TOKEN=

# The gate (defaults shown)
COMMUNAL_DAILY_USD=5
MAX_MESSAGE_CHARS=100
RATE_PER_MINUTE=6
RATE_PER_DAY=80
OWN_KEY_RATE_PER_MINUTE=20
MAX_TURNS=40

# Optional links, shown next to "paper" and "github" once set
# LINK_DOI=https://doi.org/10.5281/zenodo.22940945      # the paper's Zenodo record
# LINK_ARXIV=https://arxiv.org/abs/XXXX.XXXXX
# LINK_VIDEO=
# LINK_X=https://x.com/jevprime

# Jev's line, if you ever want to change it without touching the code
# JEV_EPIGRAPH=
# JEV_FACTS=

# shared with xbot/: lets the X bot send a whole thread as one message
XBOT_TOKEN=
