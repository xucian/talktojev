{"id": "v16", "rep": 1, "commit": "2b4fd54", "label": "baseline", "user": "tell me about yourself", "text": "i am a engineer working at a firm in chicago and also an actor. i have been doing theatre for years. i have worked as a crew on a musical in the past few years.", "words": 35, "sentences": 3, "fragments": 1, "an_errors": 1, "repeated_bigrams": 1, "calls": 1708, "by_kind": {"plan": 1, "opening": 2, "say": 877, "navigate": 672, "lookahead": 135, "beam_judge": 10, "move": 9, "critique": 2}, "lookahead_triggers": 135, "conf_mean": 0.43, "conf_min": 0.15, "beam_distinct": 0.879, "loops": 0, "trims": 2, "critique": [4, 5], "critique_final": 5, "seconds": 137.1, "empty": false}
{"id": "v16", "rep": 2, "commit": "2b4fd54", "label": "baseline", "user": "tell me about yourself", "text": "i am a person from chicago and also a engineer developing apps in tech. i work at a firm in chicago.", "words": 21, "sentences": 2, "fragments": 0, "an_errors": 1, "repeated_bigrams": 0, "calls": 1486, "by_kind": {"plan": 1, "opening": 2, "say": 742, "navigate": 614, "lookahead": 114, "beam_judge": 6, "move": 5, "critique": 2}, "lookahead_triggers": 114, "conf_mean": 0.462, "conf_min": 0.12, "beam_distinct": 0.905, "loops": 0, "trims": 1, "critique": [4, 4], "critique_final": 4, "seconds": 107.3, "empty": false}
{"id": "v17", "rep": 1, "commit": "2b4fd54", "label": "baseline", "user": "what is the meaning of life", "text": "i think it is happiness. but not just being happy but being content and peaceful. but beyond that is contribution to the world. like teaching people about purpose.", "words": 28, "sentences": 4, "fragments": 1, "an_errors": 0, "repeated_bigrams": 0, "calls": 845, "by_kind": {"plan": 1, "opening": 1, "say": 412, "navigate": 356, "lookahead": 65, "beam_judge": 5, "move": 4, "critique": 1}, "lookahead_triggers": 65, "conf_mean": 0.409, "conf_min": 0.12, "beam_distinct": 1.0, "loops": 0, "trims": 1, "critique": [6], "critique_final": 6, "seconds": 87.2, "empty": false}
